# UAE PASS OAuth2 credentials (required in production)
UAEPASS_CLIENT_ID=
UAEPASS_CLIENT_SECRET=

# Override fallback gold price in USD/oz (optional, default: 3300.0)
FALLBACK_USD_OZ=3300.0

# CORS allowed origins in production (comma-separated)
# ALLOWED_ORIGINS=https://financehouae.ae,https://app.financehouae.ae
